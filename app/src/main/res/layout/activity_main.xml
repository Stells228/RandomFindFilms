<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/halloween_dark">

    <!-- 1. Бесконечная кирпичная стена -->
    <com.example.films.WallView
        android:id="@+id/wall"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Виньетка -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vignette" />

    <!-- 3. Слой с содержимым. Отступы под системные панели задаются в MainActivity  -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Картины с табличками -->

        <FrameLayout
            android:id="@+id/world"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false" >

        </FrameLayout>

        <!-- Паук -->

        <ImageView
            android:id="@+id/spiderGroup"
            android:layout_width="180dp"
            android:layout_height="164dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="-8dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/spider" />

        <!-- Кирпичный столб -->
        <ImageView
            android:id="@+id/pillar"
            android:layout_width="125dp"
            android:layout_height="374dp"
            android:scaleType="fitXY"
            android:src="@drawable/pillar"
            android:contentDescription="@null" />

        <!-- Приведение. Оно ЗА лестницей -->
        <ImageView
            android:id="@+id/ghost"
            android:layout_width="195dp"
            android:layout_height="257dp"
            android:contentDescription="@string/ghost_description"
            android:scaleType="fitCenter"
            android:src="@drawable/ghost" />

        <!-- Длинная лестница -->
        <ImageView
            android:id="@+id/stairs"
            android:layout_width="556dp"
            android:layout_height="490dp"
            android:scaleType="fitXY"
            android:src="@drawable/stairs_strip"
            android:contentDescription="@null" />

        <!-- Паутина в верхнем левом углу -->
        <ImageView
            android:id="@+id/webTopLeft"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:adjustViewBounds="true"
            android:src="@drawable/web_1"
            android:contentDescription="@null" />

        <!-- Паутина в нижнем правом углу -->
        <ImageView
            android:id="@+id/webBottomRight"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:adjustViewBounds="true"
            android:src="@drawable/web_2"
            android:contentDescription="@null" />


        <!-- Табличка «Фильмов больше нет» -->
        <ImageView
            android:id="@+id/signNoFilms"
            android:layout_width="320dp"
            android:layout_height="313dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="60dp"
            android:src="@drawable/sign_no_films"
            android:visibility="invisible"
            android:contentDescription="@string/no_more_movies" />

        <!-- Болотная кнопка -->
        <Button
            android:id="@+id/btnRandom"
            android:layout_width="300dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/btn_swamp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_random"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </FrameLayout>
</FrameLayout>
